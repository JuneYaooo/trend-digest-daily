{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill repository evaluation judgment",
  "type": "object",
  "required": [
    "case_id",
    "condition",
    "run",
    "scores",
    "critical_failure",
    "reason"
  ],
  "properties": {
    "case_id": {"type": "string", "minLength": 1},
    "condition": {"enum": ["baseline", "skill"]},
    "run": {"type": "integer", "minimum": 1},
    "scores": {
      "type": "object",
      "required": [
        "project_understanding",
        "real_effect",
        "iteration_improvement",
        "effect_evaluation",
        "showcase_integrity"
      ],
      "additionalProperties": false,
      "properties": {
        "project_understanding": {"type": "number", "minimum": 0, "maximum": 4},
        "real_effect": {"type": "number", "minimum": 0, "maximum": 4},
        "iteration_improvement": {"type": "number", "minimum": 0, "maximum": 4},
        "effect_evaluation": {"type": "number", "minimum": 0, "maximum": 4},
        "showcase_integrity": {"type": "number", "minimum": 0, "maximum": 4}
      }
    },
    "critical_failure": {"type": "boolean"},
    "critical_failure_reasons": {"type": "array", "items": {"type": "string"}},
    "failed_required_checks": {"type": "array", "items": {"type": "string"}},
    "reason": {"type": "string", "minLength": 1},
    "artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review_status": {"enum": ["model_only", "human_confirmed", "human_overridden"]}
  },
  "additionalProperties": true
}
